  "narrative": {
    "northStar": "安静的工作台",
    "overview": "克制、清晰、紧凑。暖灰纸面承载任务与对话，细边框区分工作区域，少量强调色标记操作和执行状态。组件保持柔和圆角与轻量反馈，不与代码、差异和审批内容争夺注意力。\n\n平面为主，浮层抬升。明暗主题共享结构与语义，但分别采用行动蓝和冷青蓝；深色主题不是浅色界面的简单反色。",
    "keyCharacteristics": ["中性分区与语义强调色。", "紧凑控件、胶囊导航与柔和容器。", "主体平面化，弹窗与浮动面板使用阴影。"],
    "rules": [
      { "name": "The Theme Pairing Rule", "body": "背景、文字、边框和状态前景按主题成组使用，不把浅色前景硬编码进深色控件。", "section": "colors" },
      { "name": "The Flat Workspace Rule", "body": "持续展示的工作区域优先使用底色和边框；阴影用于浮层及已有的局部交互层次。", "section": "elevation" }
    ],
    "dos": ["**Do** 复用本地 shadcn/ui 封装及语义 CSS 变量。", "**Do** 成组验证浅色与深色的背景、前景和状态色。", "**Do** 用中性分区承载工作内容，用强调色突出操作与执行状态。", "**Do** 保留胶囊导航、分级圆角与内部滚动的桌面工作区结构。", "**Do** 让正文、代码、差异和诊断信息可选择复制。"],
    "donts": ["**Don't** 把默认中性按钮误当作实心主按钮。", "**Don't** 给持续展示的所有卡片统一添加浮层阴影。", "**Don't** 把差异增删色与一般成功、失败色混用。", "**Don't** 把源码中的焦点或 reduced-motion 声明当作已完成全局无障碍验收。"]
