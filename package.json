{
  "name": "pi-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Pi Runner · 行动派 — 本地桌面 AI 编程助手，支持影子快照、代码差异检查与文件和对话同步回滚",
  "author": "Pi Runner",
  "main": "out/main/index.mjs",
  "scripts": {
    "dev": "pnpm electron:install && electron-vite dev",
    "icons:generate": "node scripts/generate-icons.cjs",
    "electron:install": "node scripts/install-electron.cjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "pnpm electron:install && electron-vite preview",
    "test": "vitest run",
    "dist:win": "pnpm build && node scripts/export-release.cjs win",
    "dist:win:release": "pnpm build && node scripts/export-release.cjs win-release",
    "dist:win:all": "pnpm build && node scripts/export-release.cjs win-all",
    "dist:win:portable": "pnpm build && node scripts/export-release.cjs win-portable",
    "dist:win:zip": "pnpm build && node scripts/export-release.cjs win-zip",
    "dist:mac": "pnpm build && node scripts/export-release.cjs mac",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:dir": "pnpm build && node scripts/export-release.cjs dir"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@git-diff-view/core": "0.1.8",
    "@git-diff-view/file": "0.1.8",
    "@git-diff-view/react": "0.1.8",
    "@google/genai": "3.0.0",
    "@lobehub/icons-static-svg": "1.102.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "ignore": "^7.0.14",
    "lowlight": "3.3.0",
    "lucide-react": "^1.70.0",
    "marked": "18.1.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.20",
    "simple-git": "^4.0.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "dev.pirunner.desktop",
    "productName": "Pi Runner",
    "directories": {
      "output": "build-work",
      "buildResources": "resources/icons"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json",
      "!**/*.{map,d.ts,d.mts,d.cts,tsbuildinfo}",
      "!**/{README,readme,CHANGELOG,changelog,HISTORY,history,CONTRIBUTING,contributing}.{md,markdown,rst,txt}",
      "!**/{docs,doc}/**/*.{md,markdown,rst,txt,html,pdf}"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/koffi/**",
      "**/node_modules/node-pty/**",
      "out/main/chunks/inert-mcp-*.mjs"
    ],
    "extraResources": [
      {
        "from": "resources/third-party",
        "to": "third-party"
      },
      {
        "from": "resources/icons",
        "to": "icons",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      }
    ],
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "pi-runner-setup.exe"
    },
    "portable": {
      "artifactName": "pi-runner-portable.exe"
    },
    "mac": {
      "icon": "resources/icons/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.6.0 <13"
  }
}
